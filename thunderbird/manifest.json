{
  "manifest_version": 2,
  "name": "Auspex",
  "version": "0.1.0",
  "description": "Auspex mail in Thunderbird: mirrors your ship's mail into local folders and sends through the ship, over its own authenticated API. No IMAP, no SMTP.",
  "author": "nisfeb",

  "browser_specific_settings": {
    "gecko": {
      "id": "auspex@nisfeb.org",
      "strict_min_version": "128.0"
    }
  },

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "accountsRead",
    "accountsFolders",
    "accountsIdentities",
    "messagesRead",
    "messagesImport",
    "messagesUpdate",
    "messagesModify",
    "compose",
    "compose.send"
  ],

  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_action": {
    "default_title": "Auspex",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/auspex-16.png",
      "32": "icons/auspex-32.png"
    }
  },

  "message_display_action": {
    "default_title": "Auspex verdict",
    "default_icon": {
      "16": "icons/auspex-16.png",
      "32": "icons/auspex-32.png"
    }
  },

  "icons": {
    "16": "icons/auspex-16.png",
    "32": "icons/auspex-32.png",
    "48": "icons/auspex-48.png",
    "64": "icons/auspex-64.png",
    "128": "icons/auspex-128.png"
  }
}
